#!/bin/bash
set -euo pipefail

# =============================================================================
# baize-kube-update-kubeconfig — Regenerate a consumer's kubeconfig
#
# Re-extracts the token from the existing ServiceAccount Secret and
# rebuilds the kubeconfig at ~<username>/.kube/config
# (i.e. /home/<username>/.kube/config — the user's home directory).
# Useful after token rotation or cluster reconfiguration.
#
# Usage:
#   baize-kube-update-kubeconfig <username>
# =============================================================================

ADMIN_KUBECONFIG="/etc/baize-kube/admin-kubeconfig"
KUBECTL="/usr/local/bin/kubectl"


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

info()    { echo "[baize-kube] INFO:  $*"; }
success() { echo "[baize-kube] OK:    $*"; }
warn()    { echo "[baize-kube] WARN:  $*"; }
fail()    { echo "[baize-kube] ERROR: $*" >&2; exit 1; }

require_root() {
    [ "$(id -u)" -eq 0 ] || fail "This script must be run as root (or via sudo)."
}

usage() {
    cat <<EOF
Usage: baize-kube-update-kubeconfig <username>

Regenerate a consumer's kubeconfig from their existing ServiceAccount token.
Useful after token rotation or cluster reconfiguration.
EOF
    exit 0
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    local username=""
    local sa_name
    local secret_name
    local user_home
    local kubeconfig_path
    local kube_dir
    local server
    local ca_data
    local token

    # Parse args
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage ;;
            -*)
                fail "Unknown option: $1"
                ;;
            *)
                if [ -z "$username" ]; then
                    username="$1"
                else
                    fail "Unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$username" ]; then
        fail "Username is required. See --help for usage."
    fi

    require_root

    # Validate
    # Check admin kubeconfig — attempt recovery if missing
    if [ ! -r "$ADMIN_KUBECONFIG" ]; then
        # SECURITY: delegate regeneration to the hardened helper instead of
        # piping through `sudo tee` (which truncates the destination first
        # and inherits the ambient umask — a 0644 world-readable window
        # for cluster-admin credentials). The helper writes under umask 077
        # directly into the 0750 admin directory and refuses empty output.
        # We are already root (the internal `sudo` calls were redundant).
        # Absolute path: a polluted PATH (e.g. sudo -E) must never resolve
        # this privileged helper to an attacker-planted lookalike.
        if [ -x /usr/bin/baize-kube-update-admin-kubeconfig ]; then
            info "Admin kubeconfig missing — attempting regeneration..."
            /usr/bin/baize-kube-update-admin-kubeconfig 2>/dev/null || true
        fi

        # If still missing after recovery attempt, fail with helpful message
        if [ ! -r "$ADMIN_KUBECONFIG" ]; then
            fail "Admin kubeconfig not found at ${ADMIN_KUBECONFIG}."$'\n'"The cluster may not be fully installed. Try:"$'\n'"  sudo dpkg --configure baize-kube"$'\n'"  sudo make install"
        fi
    fi

    if [ ! -x "$KUBECTL" ]; then
        fail "kubectl not found at ${KUBECTL}. Is baize-kube installed?"
    fi

    if ! id "$username" > /dev/null 2>&1; then
        fail "User '${username}' does not exist on this system."
    fi

    if ! KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" get nodes --request-timeout=5s > /dev/null 2>&1; then
        fail "Cannot reach the Kubernetes cluster. Is minikube running?"
    fi

    sa_name="consumer-${username}"
    secret_name="consumer-${username}-token"

    if ! KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" get serviceaccount "$sa_name" -n default > /dev/null 2>&1; then
        fail "ServiceAccount '${sa_name}' does not exist. User '${username}' is not provisioned. Provision them first: sudo baize-kube-add-consumer ${username}"
    fi

    if ! KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" get secret "$secret_name" -n default > /dev/null 2>&1; then
        fail "Token Secret '${secret_name}' does not exist. User '${username}' may need re-provisioning."
    fi

    # Get API server URL and CA cert from admin kubeconfig
    info "Reading cluster configuration..."
    server=$(KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" config view --raw \
        -o jsonpath='{.clusters[0].cluster.server}')
    ca_data=$(KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" config view --raw \
        -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')

    # Get token from Secret. The Secret's .data.token field is BASE64-
    # ENCODED by Kubernetes; it must be decoded (base64 -d) before it can
    # serve as a bearer token in the kubeconfig. (baize-kube-add-consumer
    # does the same; writing the encoded form yields 401 Unauthorized.)
    info "Extracting token for '${username}'..."
    token=$(KUBECONFIG="$ADMIN_KUBECONFIG" "$KUBECTL" get secret "$secret_name" -n default \
        -o jsonpath='{.data.token}' | base64 -d)

    if [ -z "$token" ]; then
        fail "Token not found in Secret '${secret_name}'. The Secret may not be populated yet. Check: kubectl describe secret ${secret_name} -n default"
    fi

    # Build kubeconfig
    user_home=$(getent passwd "$username" | cut -d: -f6)
    kubeconfig_path="${user_home}/.kube/config"
    kube_dir="${user_home}/.kube"

    info "Writing kubeconfig to ${kubeconfig_path}..."
    # SECURITY: this script runs as root and writes into the TARGET USER's
    # home directory, which the target user fully controls. A pre-planted
    # symlink at ~/.kube/config (or a symlinked ~/.kube) would make root's
    # write land on an arbitrary file (e.g. /etc/sudoers.d/...). The safe
    # pattern: REFUSE if a symlink is present (checked BEFORE any
    # mkdir/mktemp so a refusal leaves no root-owned debris), write to a
    # fresh mktemp file (O_EXCL + kernel entropy — unguessable), then
    # atomically rename it over the destination. rename(2) (mv -T)
    # REPLACES symlinks instead of following them. Ownership is set on the
    # TEMP file before the rename, so nothing ever chowns the
    # user-swappable destination path after it exists.
    if [ -L "$kubeconfig_path" ] || [ -L "$kube_dir" ]; then
        fail "Refusing to write: '${kubeconfig_path}' or '${kube_dir}' is a symlink."
    fi
    # Guard against a user deleted between the earlier id check and now:
    # getent returning nothing would make mkdir -p /.kube as root.
    [ -n "$user_home" ] || fail "Could not resolve home directory for '${username}'."
    # Create .kube and fix its ownership/mode IMMEDIATELY, BEFORE any
    # further step: ~/.kube is consumer-swappable, chown/chmod follow
    # symlinks, and the invariant is that NO post-rename operation touches
    # a consumer-swappable path. -m 700 avoids a brief world-readable
    # window at the ambient umask.
    # shellcheck disable=SC2174  # -m applies to .kube (the deepest dir) —
    # exactly what we want: the parent (~) already exists with the user's
    # own mode and must not be touched.
    mkdir -p -m 700 "$kube_dir"
    chown -h "${username}:" "$kube_dir"
    chmod 700 "$kube_dir"
    tmp_config=$(mktemp "${kube_dir}/.config.baize-new.XXXXXX")

    # umask 077 in a subshell: the temp file is created 0600 so the bearer
    # token is never briefly world-readable (the default umask 022 would
    # leave a 0644 window until the chmod below).
    ( umask 077; cat > "$tmp_config" <<YAMLEOF
apiVersion: v1
kind: Config
current-context: baize-consumer
contexts:
- name: baize-consumer
  context:
    cluster: minikube
    user: consumer-${username}
clusters:
- name: minikube
  cluster:
    certificate-authority-data: ${ca_data}
    server: ${server}
users:
- name: consumer-${username}
  user:
    token: ${token}
YAMLEOF
    )
    # chown/chmod the TEMP file, THEN rename — post-rename no operation
    # touches the destination path (see security comment above).
    chown "${username}:" "$tmp_config"
    chmod 600 "$tmp_config"
    # The rename is the LAST operation (directory ownership was fixed
    # before mktemp — see above).
    mv -T "$tmp_config" "$kubeconfig_path"

    success "Kubeconfig updated at ${kubeconfig_path}."
    echo ""
    echo "The user can now run kubectl commands directly."
}

main "$@"

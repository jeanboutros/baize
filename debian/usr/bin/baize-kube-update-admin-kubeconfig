#!/bin/bash
set -euo pipefail

# =============================================================================
# baize-kube-update-admin-kubeconfig — Regenerate the SHARED admin kubeconfig
#
# The admin kubeconfig at /etc/baize-kube/admin-kubeconfig is a snapshot of
# the cluster's credentials taken at install time. It goes STALE whenever the
# minikube container is recreated (minikube delete/start, machine recreation)
# because the podman port-forward assigns a NEW random host port each time.
# The stale symptom is: "connection refused 127.0.0.1:<old-port>" for every
# admin, even though `bk minikube status` shows the cluster healthy.
#
# This script re-exports a fresh snapshot as the baize user (who owns the
# cluster's live kubeconfig) and installs it with the correct permissions.
#
# Usage:
#   sudo baize-kube-update-admin-kubeconfig
#
# NOTE: the API server endpoint in the regenerated kubeconfig is
# https://127.0.0.1:<port> — LOCAL to this machine. Remote admins must
# use an SSH tunnel (ssh -L) or run kubectl on the Pi itself.
# =============================================================================

BAIZE_USER="baize"
BAIZE_HOME="/home/${BAIZE_USER}"
# Resolve baize's uid defensively: under `set -e` a bare failing
# substitution would abort with a cryptic "no such user" message, so we
# default to empty and let each script's own existence check produce the
# friendly error.
BAIZE_UID="$(id -u "${BAIZE_USER}" 2>/dev/null || true)"
BAIZE_RUNTIME_DIR="/run/user/${BAIZE_UID}"
BAIZE_CONTAINER_HOST="unix://${BAIZE_RUNTIME_DIR}/podman/minikube-api.sock"
MINIKUBE_BIN="/usr/local/bin/minikube"
ADMIN_KUBECONFIG_DIR="/etc/baize-kube"
ADMIN_KUBECONFIG="${ADMIN_KUBECONFIG_DIR}/admin-kubeconfig"
ADMINS_GROUP="baize-admins"

info()    { echo "[baize-kube] INFO:  $*"; }
success() { echo "[baize-kube] OK:    $*"; }
warn()    { echo "[baize-kube] WARN:  $*"; }
fail()    { echo "[baize-kube] ERROR: $*" >&2; exit 1; }

require_root() {
    [ "$(id -u)" -eq 0 ] || fail "This script must be run as root (or via sudo)."
}

usage() {
    cat <<EOF
Usage: baize-kube-update-admin-kubeconfig

Regenerate the shared admin kubeconfig at ${ADMIN_KUBECONFIG}.
Run this after minikube container/machine recreation, or whenever every
admin gets "connection refused" while the cluster itself reports healthy.
EOF
    exit 0
}

main() {
    # `exit` in usage/fail ends the script, so after the case no shifting
    # is needed — every branch terminates. (shellcheck disable=SC2317)
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage ;;
            *) fail "Unexpected argument: $1" ;;
        esac
    done

    require_root

    if ! id "$BAIZE_USER" > /dev/null 2>&1; then
        fail "User '${BAIZE_USER}' does not exist. Is baize-kube installed?"
    fi

    if ! command -v "$MINIKUBE_BIN" > /dev/null 2>&1; then
        fail "minikube not found at ${MINIKUBE_BIN}. Is baize-kube installed?"
    fi

    # The kubeconfig directory must exist with the right ownership before we
    # write into it (fresh /etc/baize-kube after a state purge, for example).
    mkdir -p "$ADMIN_KUBECONFIG_DIR"
    chown "root:${ADMINS_GROUP}" "$ADMIN_KUBECONFIG_DIR"
    chmod 750 "$ADMIN_KUBECONFIG_DIR"

    # Clean up any stale staging files from an interrupted previous run
    # (a 0600 root-owned leftover holding cluster-admin credentials must
    # not linger in the admin directory across reinstalls).
    rm -f "${ADMIN_KUBECONFIG_DIR}"/.admin-kubeconfig.new.* 2>/dev/null || true

    # SECURITY + AVAILABILITY: export to a TEMP file in the same directory
    # and rename into place only on success — a transient minikube hiccup
    # must never destroy the previous (still-valid) kubeconfig. umask 077
    # inside the subshell means the temp file is 0600 from its first byte
    # (never world-readable). The directory itself is 0750 root:baize-admins
    # (no group write bit), so nobody but root can pre-plant a symlink.
    # We use runuser (util-linux, always present — postinst uses it too)
    # rather than sudo (which is NOT a declared dependency of this package).
    # `runuser -u` (unlike -l) does NOT clear the caller's environment, but
    # it DOES set HOME/SHELL/USER/LOGNAME from the target user's passwd
    # entry — so baize gets HOME=/home/baize (what minikube kubectl needs)
    # while the caller's other variables pass through. That pass-through is
    # why the explicit pins below are load-bearing: KUBECONFIG is pinned so
    # an admin's exported KUBECONFIG can never leak through and get the
    # STALE admin kubeconfig flattened instead of the live one.
    # The redirect runs as root (require_root above); runuser applies only
    # to the left side of the pipe.
    info "Exporting fresh kubeconfig as '${BAIZE_USER}'..."
    local tmp_config
    tmp_config=$(mktemp "${ADMIN_KUBECONFIG_DIR}/.admin-kubeconfig.new.XXXXXX")
    if ! ( umask 077
           # shellcheck disable=SC2024  # intentional: redirect runs as root
           runuser -u "${BAIZE_USER}" -- \
               env XDG_RUNTIME_DIR="${BAIZE_RUNTIME_DIR}" \
                   CONTAINER_HOST="${BAIZE_CONTAINER_HOST}" \
                   MINIKUBE_ROOTLESS=true \
                   KUBECONFIG="${BAIZE_HOME}/.kube/config" \
                   "${MINIKUBE_BIN}" kubectl -- config view --flatten 2>/dev/null \
               > "$tmp_config"
         ); then
        rm -f "$tmp_config"
        fail "Failed to export kubeconfig — is the cluster running? Check: bk minikube status"
    fi

    if [ ! -s "$tmp_config" ]; then
        rm -f "$tmp_config"
        fail "Exported kubeconfig is empty — the cluster may not be running. Check: bk minikube status"
    fi

    # rename(2): atomic; replaces the destination without ever following
    # a symlink at the destination.
    mv -f "$tmp_config" "$ADMIN_KUBECONFIG"

    chown "root:${ADMINS_GROUP}" "$ADMIN_KUBECONFIG"
    chmod 640 "$ADMIN_KUBECONFIG"

    # HONESTY NOTE: `config view --flatten` is a purely LOCAL file read —
    # it never contacts the API server, so a regenerated kubeconfig from a
    # stopped cluster carries the same (possibly stale) endpoint as before.
    # Warn when the API server is unreachable so the admin is not misled
    # by the success message above.
    if ! KUBECONFIG="$ADMIN_KUBECONFIG" \
            ${KUBECTL_BIN:-/usr/local/bin/kubectl} get nodes --request-timeout=5s > /dev/null 2>&1; then
        warn "Cluster API server unreachable — the regenerated kubeconfig may carry a STALE endpoint. Start the cluster: sudo -u baize env XDG_RUNTIME_DIR=/run/user/$(id -u baize) systemctl --user start minikube"
    fi

    success "Admin kubeconfig regenerated at ${ADMIN_KUBECONFIG}."
    info "NOTE: the API endpoint is local to this machine (127.0.0.1)."
    info "Consumer kubeconfigs may also be stale — refresh each with:"
    info "  sudo baize-kube-update-kubeconfig <username>"
}

main "$@"